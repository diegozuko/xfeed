# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SocialData.tools (primary — no Twitter API tier restrictions)
SOCIALDATA_API_KEY=your-socialdata-api-key

# X / Twitter API (optional fallback — Basic tier or higher for timeline read)
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# OpenAI (for summaries + TTS)
OPENAI_API_KEY=sk-your-openai-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Resend (custom email — bypasses Supabase rate limits)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=XFeed <noreply@yourdomain.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your-cron-secret
